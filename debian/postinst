#!/bin/bash
# postinst - Script ejecutado después de la instalación

set -e

case "$1" in
    configure)
        echo "✓ MasterPiece instalado correctamente"
        echo "  Ejecuta 'masterpiece' para jugar"
        echo "  Assets en /usr/share/masterpiece/"
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "postinst llamado con argumento desconocido \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0